# ==============================================================================
# VoiceSphere MVP Environment Configuration
# ==============================================================================
# NOTE: All keys below are PLACEHOLDERS for local and remote deployments.
# NEVER commit production secrets or credentials to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# LiveKit WebRTC SFU Server Configuration
# ------------------------------------------------------------------------------
# For Local Dev / Offline Testing:
#   Leave these blank or as placeholders. VoiceSphere will automatically run in
#   safe local mock voice mode with zero external credentials required.
#
# For Remote Worldwide Testing (Free LiveKit Cloud Tier):
#   1. Sign up at https://cloud.livekit.io (Free tier: 50GB/mo, 100 concurrent users)
#   2. Create a project and obtain your WebSocket URL, API Key, and Secret.
#   3. Paste them below.
#
# For Self-Hosted LiveKit Server (Docker / VPS / Fly.io):
#   Point LIVEKIT_URL to your public domain (e.g., wss://livekit.yourdomain.com)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=devkey_placeholder_abc123
LIVEKIT_API_SECRET=devsecret_placeholder_xyz987_do_not_expose

# ------------------------------------------------------------------------------
# Feature Flags (Safe Testing & Privacy)
# ------------------------------------------------------------------------------
# Set to 'true' to allow automatic fallback to local voice mock if LiveKit keys fail
DEMO_MODE=true

# Optional AI Voice Companion (Disabled by default per project requirements)
# When enabled, Aria runs locally using the browser SpeechSynthesis API with $0 cost.
ENABLE_AI_COMPANION=false

# Small-Group Testing Room Capacity Limit (default: 12 participants per room)
DEFAULT_MAX_PARTICIPANTS=12

# ------------------------------------------------------------------------------
# Google AdMob & AdSense Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMOB_PUBLISHER_ID=pub-3988357163009655
NEXT_PUBLIC_ADSENSE_CUSTOMER_ID=357-945-9110
# Production AdMob App ID from AdMob Console
NEXT_PUBLIC_ADMOB_APP_ID=ca-app-pub-3988357163009655~5124464939
# Production Ad Unit IDs from AdMob Console
NEXT_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-3988357163009655/9982487053
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-3988357163009655/7356323716
NEXT_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-3988357163009655/7909364192
